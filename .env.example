# Server-only API upstream for same-origin browser requests.
API_ORIGIN=https://manage-backend-sigma.vercel.app
# Leave empty. The browser must call the web origin so the rewrite proxy keeps
# session cookies first-party; an absolute URL here breaks sign-in (CORS
# preflight failures and SameSite=Lax cookies never sent cross-site).
NEXT_PUBLIC_API_BASE_URL=
