{
  "name": "@manage/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "db:dev": "tsx src/scripts/dev-db.ts",
    "db:verify": "tsx src/scripts/verify-indexes.ts",
    "db:indexes:apply": "tsx src/scripts/apply-indexes.ts",
    "seed": "tsx src/scripts/seed.ts",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --exclude **/*.integration.test.ts",
    "test:integration": "vitest run src/__tests__/integration"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.25",
    "@manage/api-client": "workspace:*",
    "@manage/contracts": "workspace:*",
    "@manage/database": "workspace:*",
    "@manage/domain": "workspace:*",
    "@manage/worker-core": "workspace:*",
    "better-auth": "1.7.25",
    "cors": "2.8.6",
    "dotenv": "17.2.3",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "mongodb": "7.9.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "resend": "6.38.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.2",
    "tsup": "8.5.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "tslib": "2.8.1"
  }
}
